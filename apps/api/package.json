{
  "name": "@cetakdocs/api",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --external:@hono/node-server --external:@libsql/client --external:better-sqlite3 --external:drizzle-orm --external:dotenv",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@cetakdocs/core": "workspace:*",
    "@cetakdocs/renderer": "workspace:*",
    "@cetakdocs/templates": "workspace:*",
    "@cetakdocs/validators": "workspace:*",
    "@hono/node-server": "^1.11.1",
    "@libsql/client": "^0.6.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.3.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "drizzle-kit": "^0.21.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
